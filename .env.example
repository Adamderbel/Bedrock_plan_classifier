# Copy this file to .env and fill in the values. Never commit .env.

# --- AWS auth -------------------------------------------------------------
# Short-term Bedrock API key (Bedrock console > API keys > Short-term > Generate).
# Expires after max 12h; regenerate each work session. It only works in the region
# where it was generated.
AWS_BEARER_TOKEN_BEDROCK=

# --- Model ----------------------------------------------------------------
AWS_REGION=ap-south-1
# Any Bedrock vision model with tool use works; Qwen3 VL won the model comparison.
MODEL_ID=qwen.qwen3-vl-235b-a22b

# --- Pipeline -------------------------------------------------------------
# Pages below this confidence are flagged needs_review.
REVIEW_THRESHOLD=0.6
# Highest confidence for a plan with no visible title block / sheet title.
NO_TITLE_CONFIDENCE_CAP=0.75
# Pages of one PDF classified in parallel.
PAGE_WORKERS=3
# Bytes per image sent (PNG if it fits, else JPEG). Keep a page under ~2.5 MB in total.
MAX_IMAGE_BYTES=1000000

# --- Prices (USD per 1M tokens) for the cost figures ----------------------
# Qwen3 VL 235B, on-demand, Asia Pacific (Mumbai). Update them if you change the model.
PRICE_IN=0.62
PRICE_OUT=3.13
