# Copy this file to .env and fill in the values. Never commit .env.

# --- AWS auth -------------------------------------------------------------
# Short-term Bedrock API key (Bedrock console > API keys > Short-term > Generate).
# Expires after max 12h; regenerate each work session.
AWS_BEARER_TOKEN_BEDROCK=

# --- Regions --------------------------------------------------------------
# Region used to call the Claude inference profiles.
AWS_REGION=eu-north-1
# Region used for Titan embeddings (may differ if Titan is not offered in AWS_REGION).
EMBED_REGION=eu-north-1

# --- Models ---------------------------------------------------------------
SONNET_MODEL_ID=apac.amazon.nova-pro-v1:0
OPUS_MODEL_ID=apac.amazon.nova-pro-v1:0
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Pipeline switches ----------------------------------------------------
USE_RAG=true
FAST_PATH_ENABLED=false
FAST_PATH_MIN_AGREEMENT=3
REVIEW_THRESHOLD=0.6
PAGE_WORKERS=3

# --- Prices (USD per 1M tokens) for the cost report -----------------------
# Check the Bedrock pricing page for your region and models.
PRICE_EXTRACT_IN=0.80
PRICE_EXTRACT_OUT=3.20
PRICE_DECIDE_IN=0.80
PRICE_DECIDE_OUT=3.20
PRICE_EMBED_IN=0.02
